# Copy to backend/.env (never commit .env).
# Without a provider the app runs in simulation mode: prepared lessons, scripted coach, keyword judging.

# anthropic | openai | qwen | none
MODEL_PROVIDER=none

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# Chat replies, hints and judging
ANTHROPIC_MODEL=claude-haiku-5-5
# Planner agent, track designer and lesson generator (low effort)
ANTHROPIC_PLANNER_MODEL=claude-opus-5-5

# OpenAI (Responses API, including planner tools)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_PLANNER_MODEL=gpt-6-sol
OPENAI_REASONING_EFFORT=low
OPENAI_PLANNER_REASONING_EFFORT=low
OPENAI_BASE_URL=https://api.openai.com/v1

# Qwen (OpenAI-compatible chat completions, including planner tools)
# All empty: the free OVHcloud endpoint the owl chat uses, no key needed (Qwen2.5-VL-72B-Instruct).
# Local Ollama: QWEN_BASE_URL=http://localhost:11434/v1 and QWEN_MODEL=qwen2.5:7b
# OpenRouter: QWEN_BASE_URL=https://openrouter.ai/api/v1, QWEN_API_KEY=... and QWEN_MODEL=qwen/qwen-2.5-72b-instruct
# Free models are slower: set MODEL_TIMEOUT_MS=30000 or more.
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=
QWEN_PLANNER_MODEL=

# Timeout per model call in milliseconds; on timeout the app uses prepared content
MODEL_TIMEOUT_MS=8000

# Planner limits in milliseconds: whole run and each model call (6 steps at most)
PLANNER_TOTAL_MS=45000
PLANNER_CALL_MS=20000

# Where the learner workspaces live (default: backend/var/learners, not in git)
# LEARNER_DIR=

PORT=8787

# Login for a public deployment: name:password pairs, comma-separated (no commas in passwords).
# Empty: no login, as in local development. Remove a pair to revoke that access.
# ACCESS_USERS=owner:long-secret,jury:other-secret

# English narration for newly generated video lessons; bundled lessons work without a key.
# Run npm run videos:build -- --all to rebuild prepared videos.
# local uses macOS say (Samantha) and ffmpeg; elevenlabs works on any platform.
VIDEO_SPEECH_PROVIDER=local
VIDEO_LOCAL_VOICE=Samantha
# Second host of the podcasts (same provider as above)
VIDEO_LOCAL_SECOND_VOICE=Daniel
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_SECOND_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Runtime video/audio caches (optional; default: backend/var)
# VIDEO_CACHE_DIR=
# VIDEO_SPEECH_CACHE_DIR=
# PODCAST_CACHE_DIR=
